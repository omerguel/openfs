# /etc/openfs/openfs.env — read by deploy/openfs.service (chmod 640, owner root:openfs).
# All variables: docs/operations.md → "Environment variables".

# --- Network: loopback only, the reverse proxy (Caddy/nginx) terminates TLS.
HOST=127.0.0.1
PORT=3000
# Believe X-Forwarded-Proto/-Host/-For from the proxy (Secure cookie, Origin
# check, client IP). Only with a proxy in front and HOST on loopback!
TRUST_PROXY=1

# Process time zone: backup names, the 09:00 reminder run. (The school's
# wall clock for lessons is SCHOOL_TIMEZONE, default Europe/Berlin.)
TZ=Europe/Berlin

# --- Data (inside the systemd StateDirectory /var/lib/openfs).
DB_PATH=/var/lib/openfs/fahrschule.db
FILE_STORE_DIR=/var/lib/openfs/files
BACKUP_DIR=/var/lib/openfs/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# --- Multi-tenant instead of one school (then DB_PATH is not used).
#MULTI_TENANT=1
#BASE_DOMAIN=openfs.de
#TENANTS_DIR=/var/lib/openfs/tenants
#REGISTRY_PATH=/var/lib/openfs/registry.db
#PLATFORM_SIGNUP=0

# --- Optional S3 (Hetzner Object Storage etc.): documents + offsite backups.
#S3_ENDPOINT=https://fsn1.your-objectstorage.com
#S3_BUCKET=openfs-fahrschule-muster
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=
#S3_PREFIX=

# --- E-Mail
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Fahrschule Muster <info@fahrschule-muster.de>

# --- Shown by GET /api/health and written into backup manifests when the
# checkout has no .git (release tarball, Docker image).
#OPENFS_COMMIT=
